set(CMAKE_SYSTEM_NAME Windows)
set(SF_ARCH "x86_64" CACHE STRING "x86_64 or i686")
if(NOT SF_ARCH MATCHES "^(x86_64|i686)$")
  message(FATAL_ERROR "Unsupported architecture")
endif()
set(CMAKE_SYSTEM_PROCESSOR "${SF_ARCH}")
set(SF_LLVM "$ENV{LLVM_MINGW_ROOT}")
set(CMAKE_C_COMPILER "${SF_LLVM}/bin/${SF_ARCH}-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${SF_LLVM}/bin/${SF_ARCH}-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${SF_LLVM}/bin/${SF_ARCH}-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${SF_LLVM}/${SF_ARCH}-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES SF_ARCH)
